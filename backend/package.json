    "express": "^4",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "iovalkey": "^0.4.0",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
