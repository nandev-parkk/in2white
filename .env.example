# 브라우저에서 접근할 수 있는 주소. 프런트엔드 이미지 빌드 시 고정된다.
VITE_API_BASE_URL=
ADMIN_VITE_API_BASE_URL=
ADMIN_ENVIRONMENT_LABEL=production
CORS_ORIGIN=
ADMIN_CORS_ORIGIN=

# 최초 관리자 계정. 새 DB에 계정이 없으면 이 값으로 한 번 생성합니다.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# PostgreSQL 관리자 비밀번호와 앱 전용 계정 정보.
# 비밀번호는 URL에 안전한 hex 값으로 생성한다: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_USER=in2white
POSTGRES_APP_PASSWORD=
POSTGRES_APP_DATABASE=in2white

# 서로 다른 32자 이상의 임의 값. 예: 각각 openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ADMIN_SECRET=
JWT_ADMIN_REFRESH_SECRET=
